# --- Supabase (Database + Auth) ---
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Random long string used to sign the admin/session cookie.
APP_SECRET_KEY=change-this-to-a-long-random-string
SITE_URL=http://localhost:8000

# --- Payments: Stripe (international) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Payments: SSLCOMMERZ (Bangladesh) ---
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=true

# --- Direct communication ---
WHATSAPP_NUMBER=8801XXXXXXXXX

# --- Instant admin notifications ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
DISCORD_WEBHOOK_URL=
